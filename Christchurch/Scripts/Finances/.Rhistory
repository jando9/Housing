deposit_value <- 80000
house_price <- 500000
loan_value <- house_price - deposit_value
interest_rate_pa <- 0.06
loan_term <- 30
loan_balance <-  loan_value
cumulative_interest <-  0
cumulative_principle <-  0
init_monthly_interest <-  loan_value * interest_rate_pa / 12
init_monthly_principle <-  0.2 * init_monthly_interest
monthly_total <-  init_monthly_interest + init_monthly_principle
monthly_interest <-  init_monthly_interest
init_yearly_interest <-  loan_value * interest_rate_pa
init_yearly_principle <-  0.2 * init_yearly_interest
yearly_total <-  init_yearly_interest + init_yearly_principle
yearly_interest <-  init_yearly_interest
by_month_table <- data.frame(
year = integer(),
month = integer(),
loan_balance = numeric(),
monthly_principle = numeric(),
cumulative_principle = numeric(),
monthly_interest = numeric(),
cumulative_interest = numeric()
)
by_year_table <- data.frame(
year = integer(),
loan_balance = numeric(),
monthly_principle = numeric(),
cumulative_principle = numeric(),
monthly_interest = numeric(),
cumulative_interest = numeric()
)
for (year in 1:30){
for (month in 1:12){
monthly_principle <-  monthly_total - monthly_interest
loan_balance <-  loan_balance - monthly_principle
monthly_interest <-  loan_balance * interest_rate_pa / 12
cumulative_interest <- cumulative_interest + monthly_interest
cumulative_principle <- cumulative_principle + monthly_principle
monthly_table <- data.frame(
year = year,
month = month,
loan_balance = loan_balance,
monthly_principle = monthly_interest,
cumulative_principle = cumulative_principle,
monthly_interest = monthly_interest,
cumulative_interest = cumulative_interest
)
by_month_table <- rbind(by_month_table, monthly_table)
}
yearly_principle <-  yearly_total - yearly_interest
loan_balance <-  loan_balance - yearly_principle
yearly_interest <-  loan_balance * interest_rate_pa
cumulative_interest <- cumulative_interest + yearly_interest
cumulative_principle <- cumulative_principle + yearly_principle
yearly_table <- data.frame(
year = year,
loan_balance = loan_balance,
yearly_principle = yearly_interest,
cumulative_principle = cumulative_principle,
yearly_interest = yearly_interest,
cumulative_interest = cumulative_interest
)
by_year_table <- rbind(by_year_table, yearly_table)
}
View(by_month_table)
